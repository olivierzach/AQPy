[Unit]
Description=Check AQPy sensor/model/forecast health; fail on invalid or stale data
After=postgresql.service

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/AQPy
EnvironmentFile=/home/pi/AQPy/.env
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/pi/AQPy/.venv/bin/python run_health_check.py
MemoryMax=128M
LimitAS=128M
Nice=10
TimeoutStartSec=3min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/AQPy/health
PrivateTmp=true
UMask=0077
