[Unit]
Description=AQPy chronological replay %i (bounded work slice)
After=postgresql.service
ConditionPathExists=/home/pi/AQPy/replays/%i/replay.sqlite
ConditionPathExists=!/home/pi/AQPy/replays/%i/complete

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/AQPy
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/pi/AQPy/.venv/bin/python run_replay.py run --run-dir /home/pi/AQPy/replays/%i --seconds 45
CPUQuota=25%
MemoryHigh=192M
MemoryMax=256M
LimitAS=256M
MemorySwapMax=0
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=5min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/AQPy/replays
PrivateTmp=true
UMask=0077
